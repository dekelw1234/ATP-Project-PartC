<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import View.MazeDisplayer?>  <!-- חובה לייבא את המחלקה שלך -->

<BorderPane xmlns="http://javafx.com/javafx/16"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="View.GameController"
            stylesheets="@/myStyle.css">

    <!-- כותרת עליונה -->
    <top>
        <HBox spacing="10" alignment="CENTER" styleClass="title-bar" VBox.vgrow="ALWAYS">
            <Label text="🔒 מבוך גרעיני" styleClass="label"/>
        </HBox>
    </top>

    <!-- מרכז: MazeDisplayer כולל אירוע מקש -->
    <center>
        <MazeDisplayer fx:id="mazeDisplayer"
                       width="600"
                       height="600"
                       BorderPane.alignment="CENTER"
                       styleClass="maze-canvas"
                       onKeyPressed="#handleKeyPressed"/>
    </center>

    <!-- תחתית: סטטוס -->
    <bottom>
        <Label fx:id="statusLabel"
               text="💬 מבוך נוצר"
               id="statusBar"
               BorderPane.alignment="CENTER"/>
    </bottom>

</BorderPane>
