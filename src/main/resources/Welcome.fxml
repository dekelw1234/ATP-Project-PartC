<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<?import javafx.scene.layout.HBox?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="View.WelcomeController"
            stylesheets="@myStyle.css"
            prefWidth="400" prefHeight="250">

    <children>
        <VBox spacing="15" alignment="CENTER"
              AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

            <!-- לוגו -->
            <ImageView fx:id="logoImage" fitHeight="100" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png" />
                </image>
            </ImageView>

            <!-- כותרת ראשית -->
            <Label text="ברוך הבא למבצע השמדת הכור!"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />

            <!-- שדות להזנת ממדים -->
            <HBox spacing="8" alignment="CENTER">
                <Label text="שורות:" />
                <TextField fx:id="rowsInput" promptText="למשל: 15" />
                <Label text="עמודות:" />
                <TextField fx:id="colsInput" promptText="למשל: 15" />
            </HBox>

            <!-- שורת שגיאה -->
            <Label fx:id="errorLabel" text="" styleClass="label-error" />

            <!-- כפתור התחל -->
            <Button text="🚀 התחל!" onAction="#onStartClicked" />

        </VBox>
    </children>
</AnchorPane>